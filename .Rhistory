## Table 3 - water quality
############
data_t3 <- reactive({
tmp <- wq_clip %>% dplyr::select(
-WSCSSDA, -PRPWSHID )
tmp })
output$table3 <- renderDataTable(
{ data_t3()  },
rownames = FALSE,
options = list(pageLength = 20)
)
output$downloadTable3 <- downloadHandler(
filename = function() {
